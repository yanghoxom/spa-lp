{
  "name": "PhungHaKorea canonical host",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "phungha_canonical_https_apex",
      "description": "Consolidate website HTTP and www URLs on HTTPS apex while preserving path and query",
      "expression": "(http.host eq \"www.phunghakorea.com\") or (http.host eq \"phunghakorea.com\" and not ssl)",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://phunghakorea.com\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
