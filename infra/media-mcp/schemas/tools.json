{
  "upload_media": {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "description": "Canonical versioned path under /assets/, for example /assets/serum-v2-960.webp."
        },
        "file": {
          "description": "ChatGPT file reference. The host of download_url must be on the operator's exact allowlist.",
          "type": "object",
          "properties": {
            "download_url": {
              "type": "string",
              "maxLength": 16384
            },
            "file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mime_type": {
              "type": "string",
              "maxLength": 128
            },
            "file_name": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "download_url",
            "file_id"
          ],
          "additionalProperties": false
        },
        "base64": {
          "description": "Plain canonical base64 supplied programmatically; do not put images into GitHub or invent this value.",
          "type": "string",
          "maxLength": 13333336
        },
        "content_type": {
          "type": "string",
          "enum": [
            "image/webp",
            "image/jpeg",
            "image/png",
            "image/avif"
          ]
        },
        "etag": {
          "type": "string",
          "maxLength": 140
        },
        "cache_control": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "key",
        "content_type"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "description": "Canonical versioned path under /assets/, for example /assets/serum-v2-960.webp."
        },
        "cdn_url": {
          "type": "string"
        },
        "content_type": {
          "type": "string",
          "enum": [
            "image/webp",
            "image/jpeg",
            "image/png",
            "image/avif"
          ]
        },
        "byte_size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "etag": {
          "type": "string"
        },
        "uploaded_at": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "cdn_url",
        "content_type",
        "byte_size",
        "sha256",
        "etag",
        "uploaded_at"
      ],
      "additionalProperties": false
    }
  },
  "verify_media": {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "description": "Canonical versioned path under /assets/, for example /assets/serum-v2-960.webp."
        },
        "cdn_url": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "publicly_available": {
          "type": "boolean"
        },
        "cdn_url": {
          "type": "string"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_size": {
          "type": [
            "number",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "etag": {
          "type": [
            "string",
            "null"
          ]
        },
        "integrity_ok": {
          "type": "boolean"
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cdn": {
          "type": "object",
          "properties": {
            "head_status": {
              "type": [
                "number",
                "null"
              ]
            },
            "get_status": {
              "type": [
                "number",
                "null"
              ]
            },
            "content_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "byte_size": {
              "type": [
                "number",
                "null"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "etag": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "head_status",
            "get_status",
            "content_type",
            "byte_size",
            "sha256",
            "etag"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "exists",
        "publicly_available",
        "cdn_url",
        "content_type",
        "byte_size",
        "sha256",
        "etag",
        "integrity_ok",
        "mismatches",
        "cdn"
      ],
      "additionalProperties": false
    }
  },
